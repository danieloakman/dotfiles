+/// `JOCALSEND_DOWNLOAD_DIR` pins an absolute directory (set by the Nix module).
+/// Otherwise save into the directory this process was started from.
+fn resolve_download_dir() -> Result<PathBuf> {
+    if let Some(dir) = std::env::var_os("JOCALSEND_DOWNLOAD_DIR") {
+        if !dir.is_empty() {
+            return Ok(PathBuf::from(dir));
+        }
+    }
+    Ok(std::env::current_dir()?)
+}
