{
  "name": "bun-scripts",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "bun2nix -o bun.nix",
    "build": "NODE_ENV=production bun build --target bun --outdir dist --minify src/*.ts --external=playwright-core --external=@playwright/test",
    "upgrade-interactive": "bunx npm-check-updates -i",
    "format": "prettier --write ./src",
    "lint": "prettier --check ./src",
    "db:migrate": "bunx drizzle-kit generate && bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:introspect": "bunx drizzle-kit introspect"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "latest",
    "@types/micromatch": "^4.0.10",
    "bun2nix": "^2.0.8",
    "npm-check-updates": "^19.6.3",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@danoaky/js-utils": "^0.29.2",
    "@playwright/test": "1.57",
    "basic-ftp": "^5.2.0",
    "better-sqlite3": "^12.6.2",
    "clipboardy": "^5.3.1",
    "dayjs": "^1.11.20",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "esbuild": "^0.27.4",
    "glob": "^13.0.6",
    "iteragain": "^4.1.6",
    "meow": "^14.1.0",
    "micromatch": "^4.0.8",
    "moderndash": "^4.0.0",
    "openai": "^6.27.0",
    "playwright-core": "1.57",
    "zod": "^4.3.6"
  },
  "bin": {
    "3ds-backup": "dist/3ds-backup.js",
    "move-mouse": "dist/move-mouse.js",
    "passs": "dist/passs.js"
  }
}
